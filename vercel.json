{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "backend/public/spa",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/bling/(.*)", "destination": "/api/index.js" },
    { "source": "/products/(.*)", "destination": "/api/index.js" },
    { "source": "/orders/(.*)", "destination": "/api/index.js" },
    { "source": "/admin/(.*)", "destination": "/api/index.js" },
    { "source": "/health", "destination": "/api/index.js" },
    { "source": "/spa/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/spa/(.*)", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
